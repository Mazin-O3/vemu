10 REM SUPER STAR TREK LITE
20 DIM G(8,8),Z(8,8),M(8,8),K(3,3),D(7)
40 DEF FNY(Z)=(Z<2 OR Z=7)-(Z>2 AND Z<6)
50 DEF FNX(Z)=FNY((Z+2) MOD 8)
60 PRINT "*** SUPER STAR TREK LITE ***":T=0:E=3000:S=0:P=10:N=0:C=0
90 FOR I=1 TO 8:FOR J=1 TO 8:R=RND(100):H=(R>80)+(R>95)+(R>98):N=N+H:L=RND(100)>96:C=C+L
100 G(I,J)=H*100+L*10+RND(8):NEXT J:NEXT I
110 IF C=0 THEN I=RND(64):J=(I-1) MOD 8+1:I=(I-1)\8+1:G(I,J)=G(I,J)+10:C=1
120 O=N:U=8*(24+RND(10)):IF N>=U\8 THEN U=8*(N+1)
130 A=RND(64):B=RND(64):GOSUB 2000
140 PRINT:PRINT "YOUR ORDERS: DESTROY THE ";N;" KLINGON WARSHIPS THAT HAVE INVADED"
150 PRINT "THE GALAXY WITHIN ";U\8;" DAYS. THERE ARE ";C;" STARBASE(S) FOR RESUPPLY."
160 PRINT:GOSUB 8000
900 GOSUB 2400:GOSUB 3000
910 IF T>U THEN 9100
920 IF E+S>10 THEN IF E>10 OR D(6)>=0 THEN 940
930 PRINT "** FATAL ERROR ** YOU HAVE STRANDED YOUR SHIP IN SPACE.":GOTO 9110
940 INPUT "COMMAND";A$:PRINT:IF A$="NAV" OR A$="nav" THEN 1000
948 IF A$="SRS" OR A$="srs" THEN 900
952 IF A$="LRS" OR A$="lrs" THEN 3200
956 IF A$="PHA" OR A$="pha" THEN 4000
960 IF A$="TOR" OR A$="tor" THEN 4300
964 IF A$="SHE" OR A$="she" THEN 6000
968 IF A$="DAM" OR A$="dam" THEN 6200
972 IF A$="COM" OR A$="com" THEN 6500
976 IF A$="XXX" OR A$="xxx" THEN 9110
980 GOSUB 8000:GOTO 940
1000 INPUT "COURSE (1-8)";C
1005 IF C<1 OR C>8 THEN PRINT "LT. SULU: INCORRECT COURSE DATA, SIR!":GOTO 910
1010 IF D(1)<0 THEN PRINT "WARP ENGINES DAMAGED. MAXIMUM SPEED = 2 SECTORS."
1020 INPUT "NUMBER OF SECTORS (0 TO CANCEL)";W:IF W<1 THEN 910
1030 IF W>64 OR (D(1)<0 AND W>2) THEN PRINT "SCOTT: THE ENGINES WON'T TAKE IT!":GOTO 910
1040 IF W>E THEN PRINT "ENGINEERING: INSUFFICIENT ENERGY FOR THAT MANEUVER.":GOTO 910
1050 GOSUB 5300:GOSUB 5000:GOSUB 5600:H=FNX(C-1):C=FNY(C-1):M(X,Y)=0
1080 FOR I=1 TO W:R=A+H:L=B+C
1090 IF R<1 OR R>64 OR L<1 OR L>64 THEN PRINT "GALACTIC PERIMETER - ENGINES OFF":GOTO 1130
1100 IF (R-1)\8+1<>Q1 OR (L-1)\8+1<>Q2 THEN 1120
1110 X1=(R-1) MOD 8+1:Y1=(L-1) MOD 8+1
1112 IF M(X1,Y1)<>0 THEN PRINT "ENGINES SHUT DOWN AT ";X;",";Y;" - BAD NAVIGATION":GOTO 1130
1120 A=R:B=L:X=(A-1) MOD 8+1:Y=(B-1) MOD 8+1:NEXT I
1130 E=E-W-10:IF E>=0 THEN 1140
1132 PRINT "SHIELD CONTROL SUPPLIES ENERGY TO COMPLETE THE MANEUVER."
1134 S=S+E:E=0:IF S<0 THEN S=0
1140 T=T+W:R=(A-1)\8+1:L=(B-1)\8+1:IF R=Q1 AND L=Q2 THEN 1180
1150 GOSUB 2000:PRINT "NOW ENTERING QUADRANT ";Q1;",";Q2
1160 IF V>0 THEN PRINT "COMBAT AREA - CONDITION RED"
1165 IF V>0 AND S<=200 THEN PRINT "SHIELDS DANGEROUSLY LOW"
1170 GOTO 900
1180 M(X,Y)=1:GOTO 900
2000 X=(A-1) MOD 8+1:Y=(B-1) MOD 8+1:Q1=(A-1)\8+1:Q2=(B-1)\8+1:Z(Q1,Q2)=1
2010 FOR I=1 TO 8:FOR J=1 TO 8:M(I,J)=0:NEXT J:NEXT I:FOR I=1 TO 3:K(I,3)=0:NEXT I
2030 M(X,Y)=1:V=G(Q1,Q2)\100:IF V=0 THEN 2050
2042 FOR J=1 TO V:GOSUB 2200:M(R1,R2)=2:K(J,1)=R1:K(J,2)=R2:K(J,3)=100+RND(200):NEXT J
2050 IF (G(Q1,Q2)\10) MOD 10=1 THEN GOSUB 2200:M(R1,R2)=3
2060 FOR J=1 TO G(Q1,Q2) MOD 10:GOSUB 2200:M(R1,R2)=4:NEXT J:RETURN
2200 R=RND(64):R1=(R-1)\8+1:R2=(R-1) MOD 8+1:IF M(R1,R2)<>0 THEN 2200
2210 RETURN
2400 F=0:FOR I=-1 TO 1:FOR J=-1 TO 1:R=X+I:L=Y+J:IF R<1 OR R>8 OR L<1 OR L>8 THEN 2420
2410 IF M(R,L)=3 THEN F=1
2420 NEXT J:NEXT I:C$="GREEN":IF E<300 THEN C$="YELLOW"
2440 IF V>0 THEN C$="*RED*"
2450 IF F=0 THEN 2470
2452 C$="DOCKED":E=3000:P=10:IF S>0 THEN PRINT "SHIELDS DROPPED FOR DOCKING PURPOSES":S=0
2470 RETURN
3000 IF D(2)<0 THEN PRINT "*** SHORT RANGE SENSORS ARE OUT ***":RETURN
3010 PRINT:PRINT "    1  2  3  4  5  6  7  8"
3020 FOR I=1 TO 8:PRINT I;"  ";:FOR J=1 TO 8:R=M(I,J):IF R=0 THEN PRINT " . ";
3040 IF R=1 THEN PRINT "<E>";
3050 IF R=2 THEN PRINT "+K+";
3060 IF R=3 THEN PRINT ">B<";
3070 IF R=4 THEN PRINT " * ";
3080 NEXT J:IF I=1 THEN PRINT "   STARDATE  ";3000+T\8
3100 IF I=2 THEN PRINT "   CONDITION ";C$
3110 IF I=3 THEN PRINT "   QUADRANT  ";Q1;",";Q2
3120 IF I=4 THEN PRINT "   SECTOR    ";X;",";Y
3130 IF I=5 THEN PRINT "   ENERGY    ";E
3140 IF I=6 THEN PRINT "   TORPEDOES ";P
3150 IF I=7 THEN PRINT "   SHIELDS   ";S
3160 IF I=8 THEN PRINT "   KLINGONS  ";N;"  DAYS LEFT ";(U-T)\8
3170 NEXT I:RETURN
3200 IF D(3)<0 THEN PRINT "LONG RANGE SENSORS ARE INOPERABLE":GOTO 910
3210 PRINT "LONG RANGE SCAN FOR QUADRANT ";Q1;",";Q2:PRINT "-------------"
3230 FOR I=-1 TO 1:FOR J=-1 TO 1:R=Q1+I:C=Q2+J
3240 IF R>=1 AND R<=8 AND C>=1 AND C<=8 THEN Z(R,C)=1
3250 GOSUB 3500:NEXT J:PRINT:NEXT I:PRINT "-------------":GOTO 910
3500 IF R<1 OR R>8 OR C<1 OR C>8 THEN PRINT " ***";:RETURN
3510 IF Z(R,C)=0 THEN PRINT " ***";:RETURN
3520 PRINT " ";G(R,C)\100;(G(R,C)\10) MOD 10;G(R,C) MOD 10;:RETURN
4000 IF D(4)<0 THEN PRINT "PHASER CONTROL IS DISABLED":GOTO 910
4010 IF V=0 THEN PRINT "SENSORS REPORT NO KLINGONS IN THIS QUADRANT":GOTO 910
4020 PRINT "PHASERS LOCKED ON TARGET. ENERGY AVAILABLE = ";E
4030 INPUT "NUMBER OF UNITS TO FIRE";H:IF H<1 THEN 910
4040 IF H>E THEN 4020
4050 E=E-H:IF D(7)<0 THEN H=H*RND(100)/100
4060 W=H\V:FOR I=1 TO 3:IF K(I,3)<=0 THEN 4140
4080 R=SQR(((K(I,1)-X)^2+(K(I,2)-Y)^2)*100):J=W*(19+RND(10))/R
4100 IF J<=K(I,3)*15/100 THEN PRINT "NO DAMAGE TO ENEMY AT ";K(I,1);",";K(I,2):GOTO 4140
4110 K(I,3)=K(I,3)-J:PRINT J;" UNIT HIT ON KLINGON AT SECTOR ";K(I,1);",";K(I,2)
4120 IF K(I,3)>0 THEN PRINT "   (SENSORS SHOW ";K(I,3);" UNITS REMAINING)":GOTO 4140
4130 GOSUB 4600
4140 NEXT I:GOSUB 5000:GOTO 910
4300 IF D(5)<0 THEN PRINT "PHOTON TUBES ARE NOT OPERATIONAL":GOTO 910
4310 IF P<1 THEN PRINT "ALL PHOTON TORPEDOES EXPENDED":GOTO 910
4320 INPUT "TARGET ROW (1-8)";H:INPUT "TARGET COLUMN (1-8)";C
4330 IF H<1 OR H>8 OR C<1 OR C>8 OR (H=X AND C=Y) THEN PRINT "TORPEDO CANCELLED":GOTO 910
4340 R=H-X:L=C-Y:J=ABS(R):IF ABS(L)>J THEN J=ABS(L)
4350 P=P-1:PRINT "TORPEDO TRACK:"
4360 FOR I=1 TO 16:H=X+(2*R*I+SGN(R*I)*J)/(2*J):C=Y+(2*L*I+SGN(L*I)*J)/(2*J)
4370 IF H<1 OR H>8 OR C<1 OR C>8 THEN PRINT "TORPEDO MISSED":GOTO 4500
4380 PRINT "   ";H;",";C:W=M(H,C):IF W=0 THEN 4490
4390 IF W=4 THEN PRINT "STAR AT ";H;",";C;" ABSORBED TORPEDO ENERGY.":GOTO 4500
4400 IF W<>3 THEN 4410
4402 PRINT "*** STARBASE DESTROYED ***":M(H,C)=0:G(Q1,Q2)=G(Q1,Q2)-10:F=0:GOTO 4500
4410 FOR W=1 TO 3:IF K(W,1)=H AND K(W,2)=C AND K(W,3)>0 THEN I=W:GOSUB 4600
4420 NEXT W:GOTO 4500
4490 NEXT I
4500 GOSUB 5000:GOTO 910
4600 PRINT "*** KLINGON DESTROYED ***":M(K(I,1),K(I,2))=0:K(I,3)=0
4610 V=V-1:N=N-1:G(Q1,Q2)=G(Q1,Q2)-100:IF N<=0 THEN 9000
4620 RETURN
5000 IF V=0 THEN RETURN
5010 IF F=1 THEN PRINT "STARBASE SHIELDS PROTECT THE ENTERPRISE":RETURN
5020 FOR I=1 TO 3:IF K(I,3)<=0 THEN 5090
5030 R=SQR(((K(I,1)-X)^2+(K(I,2)-Y)^2)*100)
5040 H=K(I,3)*(19+RND(10))/R:S=S-H:K(I,3)=K(I,3)*10/(30+RND(10))+1
5050 PRINT H;" UNIT HIT ON ENTERPRISE FROM SECTOR ";K(I,1);",";K(I,2):IF S<0 THEN 9200
5070 PRINT "      <SHIELDS DOWN TO ";S;" UNITS>"
5080 IF H>=20 AND RND(100)<=60 AND H*50>S THEN GOSUB 5700
5090 NEXT I:RETURN
5300 IF V=0 THEN RETURN
5310 FOR I=1 TO 3:IF K(I,3)<=0 THEN 5340
5320 M(K(I,1),K(I,2))=0:GOSUB 2200:M(R1,R2)=2:K(I,1)=R1:K(I,2)=R2
5340 NEXT I:RETURN
5600 H=W:IF H>8 THEN H=8
5610 FOR R=1 TO 7:IF D(R)>=0 THEN 5640
5620 D(R)=D(R)+H:IF D(R)<0 THEN 5640
5630 D(R)=0:GOSUB 6380:PRINT " REPAIR COMPLETED."
5640 NEXT R:IF RND(100)>20 THEN RETURN
5660 R=RND(7):IF RND(100)>=60 THEN 5690
5670 D(R)=D(R)-RND(40)-8:GOSUB 6380:PRINT " DAMAGED":RETURN
5690 IF D(R)>=0 THEN RETURN
5695 D(R)=D(R)+RND(24)+8:IF D(R)>0 THEN D(R)=0
5697 GOSUB 6380:PRINT " STATE OF REPAIR IMPROVED":RETURN
5700 R=RND(7):D(R)=D(R)-RND(8)-8*H/(S+30)
5710 PRINT "DAMAGE CONTROL: ";:GOSUB 6300:PRINT " DAMAGED BY THE HIT":RETURN
6000 IF D(6)<0 THEN PRINT "SHIELD CONTROL IS INOPERABLE":GOTO 910
6010 PRINT "ENERGY AVAILABLE = ";E+S:INPUT "NUMBER OF UNITS TO SHIELDS";H
6020 IF H<0 OR H=S THEN PRINT "<SHIELDS UNCHANGED>":GOTO 910
6030 IF H>E+S THEN PRINT "THIS IS NOT THE FEDERATION TREASURY. <SHIELDS UNCHANGED>":GOTO 910
6040 E=E+S-H:S=H:PRINT "SHIELDS NOW AT ";S;" UNITS PER YOUR COMMAND.":GOTO 910
6200 PRINT "REPAIR DAYS  DEVICE":H=0:FOR R=1 TO 7:PRINT "   ";:IF D(R)>=0 THEN PRINT " ";
6214 PRINT (D(R)-7)\8;"   ";:GOSUB 6300:PRINT:IF D(R)<0 THEN H=H-D(R)
6220 NEXT R:IF H=0 OR F=0 THEN 910
6240 PRINT "TECHNICIANS STANDING BY TO EFFECT REPAIRS TO YOUR SHIP."
6250 PRINT "ESTIMATED TIME TO REPAIR: ";(H+7)\8;" DAYS."
6260 INPUT "WILL YOU AUTHORIZE THE REPAIR ORDER (Y/N)";A$:IF A$<>"Y" AND A$<>"y" THEN 910
6280 FOR R=1 TO 7:D(R)=0:NEXT R:T=T+H:GOTO 910
6300 IF R=1 THEN PRINT "WARP ENGINES";
6310 IF R=2 THEN PRINT "SHORT RANGE SENSORS";
6320 IF R=3 THEN PRINT "LONG RANGE SENSORS";
6330 IF R=4 THEN PRINT "PHASER CONTROL";
6340 IF R=5 THEN PRINT "PHOTON TUBES";
6350 IF R=6 THEN PRINT "SHIELD CONTROL";
6360 IF R=7 THEN PRINT "COMPUTER";
6370 RETURN
6380 PRINT "DAMAGE CONTROL REPORT: ";:GOSUB 6300:RETURN
6500 IF D(7)<0 THEN PRINT "COMPUTER DISABLED":GOTO 910
6510 PRINT "GALACTIC RECORD (KLINGONS,BASES,STARS)"
6515 PRINT "    1   2   3   4   5   6   7   8"
6520 FOR R=1 TO 8:PRINT R;" ";:FOR C=1 TO 8:GOSUB 3500:NEXT C:PRINT:NEXT R:GOTO 910
8000 PRINT "ENTER ONE OF THE FOLLOWING:":PRINT "  NAV  SET COURSE (1-8) AND SECTORS TO MOVE"
8020 PRINT "  SRS  SHORT RANGE SCAN    LRS  LONG RANGE SCAN"
8030 PRINT "  PHA  FIRE PHASERS        TOR  FIRE PHOTON TORPEDO"
8040 PRINT "  SHE  SET SHIELDS         DAM  DAMAGE REPORT"
8050 PRINT "  COM  GALACTIC RECORD     XXX  RESIGN"
8060 PRINT "COURSES: 1=RIGHT 3=UP 5=LEFT 7=DOWN  (2,4,6,8 ARE DIAGONALS)"
8070 PRINT "SYMBOLS: <E> YOU  +K+ KLINGON  >B< STARBASE  * STAR":RETURN
9000 PRINT:PRINT "CONGRATULATIONS, CAPTAIN! THE LAST KLINGON BATTLE CRUISER"
9010 PRINT "MENACING THE FEDERATION HAS BEEN DESTROYED."
9020 R=O*800/(T+8):PRINT:PRINT "YOUR EFFICIENCY RATING IS ";R*R/10:END
9100 PRINT:PRINT "IT IS STARDATE ";3000+T\8;". YOU RAN OUT OF TIME."
9110 PRINT "THERE WERE ";N;" KLINGON BATTLE CRUISERS LEFT AT THE END OF YOUR MISSION.":END
9200 PRINT:PRINT "THE ENTERPRISE HAS BEEN DESTROYED. THE FEDERATION WILL BE CONQUERED."
9210 GOTO 9110
